{
  "name": "CTF Portal",
  "short_name": "CTF Portal",
  "description": "CTF競技用の変換・解析ツールをまとめたポータル。オフラインでも動作します。",
  "lang": "ja",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#04080f",
  "theme_color": "#04080f",
  "categories": ["utilities", "developer", "security"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "エンコード / デコード", "url": "./#codec", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "ファイル解析", "url": "./#file", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "問題メモ・フラグ記録", "url": "./#notes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
